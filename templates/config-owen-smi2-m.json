            {
                "name": "value_int",
                "address": 4200,
                "format": "s16",
                "min": -32768,
                "max": 32767,
                "condition": "data_type==0",
                "group": "g_general"
            },
            {
                "name": "value_real",
                "address": 4206,
                "format": "float",
                "word_order": "little_endian",
                "condition": "data_type==4",
                "group": "g_general"
            },
            {
                "name": "value_string",
                "address": 4208,
                "type": "text",
                "format": "string8",
                "string_data_size": 16,
                "condition": "data_type==5",
                "group": "g_general"
            },
            {
                "name": "color",
                "address": 4100,
                "enum": ["0", "1", "2"],
                "enum_titles": ["color_enum_0", "color_enum_1", "color_enum_2"],
                "group": "g_general"
            },
            {
                "name": "brightness",
                "address": 4101,
                "type": "range",
                "min": 0,
                "max": 100,
                "units": "%",
                "group": "g_general"
            },
            {
                "name": "blink",
                "address": 4102,
                "type": "switch",
                "group": "g_general"
            },
            {
                "name": "blink_period",
                "address": 4103,
                "scale": 0.001,
                "units": "s",
                "min": 0.25,
                "max": 3,
                "group": "g_general"
            },
            {
                "name": "display_mode",
                "address": 4106,
                "enum": ["0", "1", "2"],
                "enum_titles": ["display_mode_enum_0", "display_mode_enum_1", "display_mode_enum_2"],
                "group": "g_general"
            },
            {
                "name": "scroll_period",
                "address": 4105,
                "scale": 0.001,
                "units": "s",
                "min": 0.1,
                "max": 1.5,
                "group": "g_general"
            },
            {
                "name": "leading_zeros",
                "address": 4104,
                "enum": ["0", "1", "2", "3"],
                "enum_titles": ["0", "1", "2", "3"],
                "group": "g_general"
            },
            {
                "name": "decimal_point",
                "address": 4108,
                "enum": ["0", "1", "2", "3"],
                "enum_titles": ["----", "---.-", "--.--", "-.---"],
                "group": "g_general"
            },
            {
                "name": "alarm_zone_misconfig",
                "address": "61620:26:1",
                "format": "u32",
                "word_order": "little_endian",
                "type": "alarm",
                "readonly": true,
                "group": "g_general"
            },
            {
                "name": "alarm_underrange",
                "address": "61620:27:1",
                "format": "u32",
                "word_order": "little_endian",
                "type": "alarm",
                "readonly": true,
                "group": "g_general"
            },
            {
                "name": "alarm_overrange",
                "address": "61620:28:1",
                "format": "u32",
                "word_order": "little_endian",
                "type": "alarm",
                "readonly": true,
                "group": "g_general"
            },
            {
                "name": "flash_resource",
                "address": 61624,
                "units": "%",
                "readonly": true,
                "group": "g_general"
            },
            {
                "name": "cmd_save_settings",
                "address": 5000,
                "type": "pushbutton",
                "on_value": 1,
                "group": "g_general"
            }
        ],
