            },
            {
                "title": "g_modbus",
                "id": "g_modbus",
                "order": 3
            },
            {
                "title": "g_general",
                "id": "g_general",
                "order": 4
            }
        ],
        "setup": [
            {
                "title": "Arm save-to-flash edge detector",
                "address": 5000,
                "value": 0
            }
        ],
        "parameters": [
            {
                "id": "data_type",
                "title": "data_type",
                "description": "data_type_description",
                "address": 4107,
