                "enum_titles": ["INT", "REAL", "STRING"],
                "default": 0,
                "group": "g_display",
                "order": 1
            },
            {
                "id": "slope_coefficient",
                "title": "slope_coefficient",
                "description": "slope_coefficient_description",
                "address": 4111,
                "format": "float",
                "word_order": "little_endian",
                "default": 1,
                "min": -999,
                "max": 9999,
                "condition": "data_type!=5",
                "group": "g_display",
                "order": 2
            },
            {
                "id": "offset_coefficient",
                "title": "offset_coefficient",
                "description": "offset_coefficient_description",
                "address": 4109,
                "format": "float",
                "word_order": "little_endian",
                "default": 0,
                "min": -999,
                "max": 9999,
                "condition": "data_type!=5",
                "group": "g_display",
                "order": 3
            },
            {
                "id": "string_length",
                "title": "string_length",
                "description": "string_length_description",
                "address": 4249,
                "default": 4,
                "min": 4,
                "max": 32,
                "condition": "data_type==5",
                "group": "g_display",
                "order": 4
            },
            {
                "id": "logic_enabled",
                "title": "logic_enabled",
                "description": "logic_enabled_description",
                "address": 4300,
                "enum": [0, 1],
                "enum_titles": ["logic_enabled_enum_0", "logic_enabled_enum_1"],
                "default": 0,
                "group": "g_display",
                "order": 5
            },
            {
                "id": "safe_state_timeout",
                "title": "safe_state_timeout",
