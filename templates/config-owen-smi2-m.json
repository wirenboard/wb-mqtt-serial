                "default": 0,
                "group": "g_safety",
                "order": 3
            },
            {
                "id": "safe_state_blink",
                "title": "safe_state_blink",
                "address": 4066,
                "enum": [0, 1],
                "enum_titles": ["safe_state_blink_enum_0", "safe_state_blink_enum_1"],
                "default": 0,
                "group": "g_safety",
                "order": 4
            },
            {
                "id": "modbus_address",
                "title": "modbus_address",
                "address": 527,
                "min": 1,
                "max": 247,
                "group": "g_modbus",
                "order": 1
            },
            {
                "id": "baud_rate",
                "title": "baud_rate",
                "address": 521,
                "enum": [3, 4, 5, 6, 7, 8, 9, 10],
                "enum_titles": ["2400", "4800", "9600", "14400", "19200", "38400", "57600", "115200"],
                "group": "g_modbus",
                "order": 2
            },
            {
                "id": "parity",
                "title": "parity",
                "address": 524,
                "enum": [0, 1, 2],
                "enum_titles": ["N", "E", "O"],
