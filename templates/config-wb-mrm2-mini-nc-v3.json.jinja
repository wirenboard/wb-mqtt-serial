{% set OUTPUTS_NUMBER = 2 -%}
{% set MMATRIX_OUTPUTS_NUMBER = 2 -%}
{% set FIRST_INPUT = 1 -%}
{% set W1_MODE = 7 -%}
{#- Output actions in the order of their register values; the relay contacts are normally closed, so 1 (coil off) turns the load on -#}
{% set OUTPUT_ACTIONS = [("No Action", "Ничего не делать"), ("Turn On", "Включить"), ("Turn Off", "Выключить"), ("Toggle", "Переключить")] -%}
{#- Mapping-matrix value = 4 * action on close + action on open -#}
{% set MAPPING_MATRIX_ACTIONS = [] -%}
{% for on_close in OUTPUT_ACTIONS -%}
    {% for on_open in OUTPUT_ACTIONS -%}
        {% set _ = MAPPING_MATRIX_ACTIONS.append((on_close, on_open)) -%}
    {% endfor -%}
{% endfor -%}
{#- Comparisons with != are true for a parameter absent from the config, so they are guarded by isDefined -#}
{% macro thermostat_on(out_num) -%}
    (isDefined(out{{out_num}}_thermostat_source)&&out{{out_num}}_thermostat_source!=0)
{%- endmacro -%}
{% macro thermostat_off(out_num) -%}
    (isDefined(out{{out_num}}_thermostat_source)==0||out{{out_num}}_thermostat_source==0)
{%- endmacro %}
{
    "device_type": "wb-mrm2-mini-nc-v3",
    "group": "g-wb",
    "hw": [
        {
            "signature": "WB-MRM2-mini v.3/NC"
        }
    ],
    "device": {
        "name": "WB-MRM2-mini v.3/NC",
        "id": "wb-mrm2-mini-nc",
        "max_read_registers": 0,
        "response_timeout_ms": 1,
        "frame_timeout_ms": 8,
        "enable_wb_continuous_read": true,

        "groups": [
            {% for in_num in range(FIRST_INPUT, OUTPUTS_NUMBER + 1) -%}
