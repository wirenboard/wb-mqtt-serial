                "group": "gg_timer_{{out_num}}",
                "order": {{out_num + 1}},
                "address": {{1792 + out_num - 1}},
                "reg_type": "holding",
                "scale": 0.1,
                "min": 0.1,
                "max": 6500,
                "default": 3,
                "condition": "(out{{out_num}}_timer_mode_selection==4||out{{out_num}}_timer_mode_selection==7)&&{{ thermostat_off(out_num) }}"
            },
            {
