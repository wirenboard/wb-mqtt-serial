                "address": {{1648 + out_num - 1}},
                "reg_type": "holding",
                "default": 0,
                "enum": [0, 1, 2],
                "enum_titles": [
                    "No Action",
                    "Turn On",
                    "Turn Off"
                ],
                "condition": "{{ thermostat_on(out_num) }}"
            },
            {
                "id": "out{{out_num}}_safety_input_control",
                "title": "Output {{out_num}}",
                "group": "gg_safety_input_control",
                "order": {{out_num}},
                "address": {{946 + out_num - 1}},
                "reg_type": "holding",
                "default": 0,
                "enum": [0, 1, 2],
                "enum_titles": [
                    "Don't change",
                    "Disable in safety mode",
                    "Enable only in safety mode"
                ],
                "condition": "{{ thermostat_off(out_num) }}"
            },
            {
                "id": "out{{out_num}}_startup_delay_params",
                "title": "Output {{out_num}}",
                "group": "gg_startup_delay_params",
                "order": {{out_num}},
                "address": {{1728 + out_num - 1}},
                "reg_type": "holding",
                "scale": 0.1,
                "min": 0,
                "max": 999,
                "default": 0
            },
            {
                "id": "out{{out_num}}_restart_delay_params",
                "title": "Output {{out_num}}",
                "group": "gg_restart_delay_params",
