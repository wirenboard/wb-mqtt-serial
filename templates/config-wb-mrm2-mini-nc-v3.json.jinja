                "id": "gg_debug_in{{in_num}}_channels",
                "group": "g_debug"
            }{% if not loop.last %},{% endif %}
            {% endfor -%}
        ],

        "parameters": [
            {% for in_num in range(FIRST_INPUT, OUTPUTS_NUMBER + 1) -%}
