                "order": 4,
                "address": {{1672 + out_num - 1}},
                "reg_type": "holding",
                "scale": 0.0625,
                "default": 0.5,
                "min": 0.0625,
                "max": 10,
                "condition": "{{ thermostat_on(out_num) }}&&out{{out_num}}_thermostat_mode{{ '==' if cooling else '!=' }}1"
            },
            {% endfor -%}
            {% endfor -%}
            {
                "id": "baud_rate",
                "title": "Baud rate",
                "description": "baud_rate_description",
                "address": 110,
                "reg_type": "holding",
                "enum": [96, 192, 384, 576, 1152],
                "default": 96,
                "enum_titles": [
                    "9600",
                    "19200",
                    "38400",
                    "57600",
                    "115200"
                ],
                "group": "g_general",
                "order": 1
            },
            {
                "id": "disable_indication",
                "title": "Status LED",
                "address": 130,
                "reg_type": "holding",
                "enum": [0, 1],
                "enum_titles": ["Enabled", "Disabled"],
                "default": 0,
                "group": "g_general",
                "order": 2
            },
            {% set W1_ANY_INPUT_CONDITION -%}
