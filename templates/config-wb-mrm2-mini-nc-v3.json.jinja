                "address": {{1736 + out_num - 1}},
                "reg_type": "holding",
                "scale": 0.1,
                "min": 0,
                "max": 999,
                "default": 0,
                "condition": "isDefined(out{{out_num}}_timer_mode_selection)==0||out{{out_num}}_timer_mode_selection==0||{{ thermostat_on(out_num) }}"
            },
            {
                "id": "out{{out_num}}_timer_mode_selection",
                "title": "Function",
                "group": "gg_timer_{{out_num}}",
                "order": {{out_num}},
                "address": {{1760 + out_num - 1}},
                "reg_type": "holding",
                "default": 0,
                "enum": [0, 1, 2, 3, 6, 4, 7, 5],
                "enum_titles": [
                    "Not Used",
                    "Off Delay",
                    "On Delay",
                    "Off Pulse",
                    "Off Pulse (Reset Command)",
                    "On Pulse",
                    "On Pulse (Reset Command)",
                    "Off/On Cycle"
                ],
                "condition": "{{ thermostat_off(out_num) }}"
            },
            {
                "id": "out{{out_num}}_on_delay_params",
