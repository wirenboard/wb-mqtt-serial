                "default": 3,
                "condition": "out{{out_num}}_timer_mode_selection==5&&{{ thermostat_off(out_num) }}"
            },
            {
                "id": "out{{out_num}}_cyclic_off_time_params",
                "title": "On Time (s)",
                "group": "gg_timer_{{out_num}}",
                "order": {{out_num + 2}},
                "address": {{1808 + out_num - 1}},
                "reg_type": "holding",
                "scale": 1,
                "min": 1,
                "max": 65000,
                "default": 3,
                "condition": "out{{out_num}}_timer_mode_selection==5&&{{ thermostat_off(out_num) }}"
            },
            {% endfor -%}
            {% set any_latching_cond = [] -%}
            {% set no_latching_cond = [] -%}
            {% for in_num in range(1, OUTPUTS_NUMBER + 1) -%}
                {% set _ = any_latching_cond.append("in" ~ in_num ~ "_mode==1") -%}
                {% set _ = no_latching_cond.append("in" ~ in_num ~ "_mode!=1") -%}
            {% endfor -%}
            {% set free_output_cond = [] -%}
            {% set any_thermostat_cond = [] -%}
            {% for out_num in range(1, OUTPUTS_NUMBER + 1) -%}
                {% set _ = free_output_cond.append(thermostat_off(out_num)) -%}
                {% set _ = any_thermostat_cond.append(thermostat_on(out_num)) -%}
            {% endfor -%}
            {% for any_latching, any_thermostat, description in [
                (true, false, "outputs_state_after_power_on_description"),
                (false, false, ""),
                (true, true, "outputs_state_after_power_on_latching_thermostat_description"),
                (false, true, "outputs_state_after_power_on_thermostat_description"),
            ] -%}
            {% set restore_cond = any_latching_cond | join("||") if any_latching else no_latching_cond | join("&&") -%}
            {% set thermostat_cond = any_thermostat_cond | join("||") if any_thermostat else free_output_cond | join("&&") -%}
            {
                "id": "outputs_restore_state",
                "title": "Outputs State After Power On",
                {% if description -%}
                "description": "{{ description }}",
                {% endif -%}
                "address": 6,
                "reg_type": "holding",
                {% if any_latching %}"enum": [0, 1, 2],{% else %}"enum": [0, 1],{% endif %}
                "default": 0,
                "enum_titles": ["Switch Output To Safe State", "Restore Last State"{% if any_latching %}, "According To Inputs"{% endif %}],
                "condition": "({{ restore_cond }})&&({{ thermostat_cond }})&&({{ free_output_cond | join('||') }})",
                "order": 1,
                "group": "g_outputs"
            },
            {% endfor -%}
            {
                "id": "safety_timer_s",
                "title": "Safety Poll Timeout (s)",
                "group": "g_safety",
                "description": "poll_timeout_description",
                "address": 8,
                "order": 2,
                "reg_type": "holding",
                "min": 1,
                "max": 65534,
                "default": 10
            },
            {% for out_num in range(1, OUTPUTS_NUMBER + 1) -%}
            {
                "id": "out{{out_num}}_thermostat_source",
                "title": "Temperature Sensor",
                "group": "gg_thermostat_{{out_num}}",
                "order": 1,
                "address": {{1632 + out_num - 1}},
                "reg_type": "holding",
                "default": 0,
                "enum": [0{% for in_num in range(FIRST_INPUT, OUTPUTS_NUMBER + 1) %}, {{in_num - FIRST_INPUT + 1}}{% endfor %}],
                "enum_titles": [
                    "Not Used"{% for in_num in range(FIRST_INPUT, OUTPUTS_NUMBER + 1) %},
