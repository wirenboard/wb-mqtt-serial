                ]
            },
            {
                "id": "out{{out_num}}_thermostat_mode",
                "title": "Mode",
                "group": "gg_thermostat_{{out_num}}",
                "order": 2,
                "address": {{1640 + out_num - 1}},
                "reg_type": "holding",
                "default": 0,
                "enum": [0, 1],
                "enum_titles": [
                    "Heating",
                    "Cooling"
                ],
                "condition": "{{ thermostat_on(out_num) }}"
            },
            {
                "id": "out{{out_num}}_thermostat_setpoint",
                "title": "Temperature Setpoint (°C)",
                "group": "gg_thermostat_{{out_num}}",
                "order": 3,
                "address": {{1664 + out_num - 1}},
