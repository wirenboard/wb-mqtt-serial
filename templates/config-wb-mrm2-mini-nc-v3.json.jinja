                    "No Action",
                    "Switch Output To Safe State"{% if latching %},
                    "Switch Output According To Input State"{% endif %}
                ],
                "condition": "in{{out_num}}_mode{{ '==' if latching else '!=' }}1&&{{ thermostat_off(out_num) }}"
            },
            {% endfor -%}
            {
                "id": "out{{out_num}}_thermostat_safety_action",
                "title": "Output {{out_num}}",
                "description": "thermostat_safety_action_description",
                "group": "gg_safety_behaviour",
