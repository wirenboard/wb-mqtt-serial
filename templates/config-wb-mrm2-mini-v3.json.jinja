{% set OUTPUTS_NUMBER = 2 -%}
{% set CURTAINS_NUMBER = OUTPUTS_NUMBER // 2 -%}
{% set MMATRIX_OUTPUTS_NUMBER = 2 -%}
{% set CURTAINS_MMATRIX_OUTPUTS_NUMBER = 4 -%}
{% set FIRST_INPUT = 1 -%}
{% set W1_MODE = 7 -%}
{#- Output actions in the order of their register values -#}
{% set OUTPUT_ACTIONS = [("No Action", "Ничего не делать"), ("Turn Off", "Выключить"), ("Turn On", "Включить"), ("Toggle", "Переключить")] -%}
{#- Mapping-matrix value = 4 * action on close + action on open -#}
{% set MAPPING_MATRIX_ACTIONS = [] -%}
{% for on_close in OUTPUT_ACTIONS -%}
    {% for on_open in OUTPUT_ACTIONS -%}
        {% set _ = MAPPING_MATRIX_ACTIONS.append((on_close, on_open)) -%}
    {% endfor -%}
{% endfor -%}
{% macro curtain_free(out_num) -%}
    (isDefined(curtain{{ (out_num + 1) // 2 }}_mode)==0||curtain{{ (out_num + 1) // 2 }}_mode==0)
{%- endmacro -%}
{#- Comparisons with != are true for a parameter absent from the config, so they are guarded by isDefined -#}
{% macro thermostat_on(out_num) -%}
    (isDefined(out{{out_num}}_thermostat_source)&&out{{out_num}}_thermostat_source!=0)
{%- endmacro -%}
{% macro thermostat_off(out_num) -%}
    (isDefined(out{{out_num}}_thermostat_source)==0||out{{out_num}}_thermostat_source==0)
{%- endmacro %}
