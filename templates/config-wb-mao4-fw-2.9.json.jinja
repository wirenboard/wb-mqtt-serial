{% set title_en = title_en | default("WB-MAO4 fw2.9 (4-channel analog output module)") -%}
{% set title_ru = title_ru | default("WB-MAO4 fw2.9 (4-канальный модуль аналогового вывода)") -%}
{% set device_type = device_type | default("WB-MAO4-since-fw-2.9") -%}
{% set group = group | default("g-wb") -%}
{% set device_name = device_name | default("WB-MAO4") -%}
{% set device_id = device_id | default("wb-mao4") -%}
{% set has_signature = has_signature | default(true) -%}
{% set INPUTS_NUMBER = 3 -%}
{% set OUTPUTS_NUMBER = 4 -%}
{% set ENCODERS_NUMBER = 1 -%}
{% set ENCODER_CHANGE_STEP_DEFAULT = 1 -%}
{% set ENCODER_CHANGE_STEP_MAX = 100 -%}
{% set PRESS_TYPES = ["short", "long", "double", "short long"] -%}
{% set SHORT_PRESS_TYPES = ["short", "double"] -%}
{% set SHORT_PRESS_CHANGE_STEP_DEFAULT = 1 -%}
{% set SHORT_PRESS_CHANGE_STEP_MAX = 100 -%}
{% set LIGHT_SCENES_NUMBER = 8 -%}
{
    "title": "template_title",
    "device_type": "{{ device_type }}",
    "group": "{{ group }}",
{% if has_signature %}
    "hw": [
        {
            "signature": "WBMAO4",
            "fw": "2.9.0"
        }
    ],
{% endif %}
    "device": {
        "name": "{{ device_name }}",
        "id": "{{ device_id }}",
        "max_read_registers": 0,
        "response_timeout_ms": 1,
        "frame_timeout_ms": 0,
        "enable_wb_continuous_read": true,
        "groups": [
            {% for ch_number in range(1, INPUTS_NUMBER + 1) -%}
            {
                "title": "g_in{{ ch_number }}",
                "id": "g_in{{ ch_number }}"
            },
            {% for press_type in PRESS_TYPES -%}
            {
                "title": "gg_{{ press_type | replace(' ', '_') }}_press_action",
                "id": "gg_in{{ ch_number }}_{{ press_type | replace(' ', '_') }}_press_action",
                "group": "g_in{{ ch_number }}"
            },
            {% endfor -%}
            {
                "title": "gg_switch_on_action",
                "id": "gg_in{{ ch_number }}_switch_on_action",
                "group": "g_in{{ ch_number }}"
            },
            {
                "title": "gg_switch_off_action",
                "id": "gg_in{{ ch_number }}_switch_off_action",
                "group": "g_in{{ ch_number }}"
            },
            {
                "title": "gg_press_params",
                "id": "gg_in{{ ch_number }}_press_params",
                "group": "g_in{{ch_number}}",
                "ui_options": {
                    "wb": {
                        "disable_title": true
                    }
                }
            },
            {
                "title": "gg_in_channels",
                "id": "gg_in{{ ch_number }}_channels",
                "group": "g_in{{ ch_number }}",
                "ui_options": {
                    "wb": {
                        "disable_title": true
                    }
                }
            },
            {% endfor -%}
            {
                "title": "g_outputs",
                "id": "g_outputs"
            },
            {
                "title": "gg_outputs_common",
                "id": "gg_outputs_common",
                "group": "g_outputs"
            },
            {% for ch_number in range(1, OUTPUTS_NUMBER + 1) -%}
            {
                "title": "g_out{{ ch_number }}",
                "id": "g_out{{ ch_number }}",
                "group": "g_outputs"
            },
            {% endfor -%}
            {
                "title": "gg_output_channels",
                "id": "gg_output_channels",
                "group": "g_outputs",
                "ui_options": {
                    "wb": {
                        "disable_title": true
                    }
                }
            },
            {
                "title": "g_encoders",
                "id": "g_encoders"
            },
            {% for encoder_number in range(1, ENCODERS_NUMBER + 1) -%}
            {
                "title": "gg_encoder_{{encoder_number}}",
                "id": "gg_encoder_{{encoder_number}}",
                "group": "g_encoders"
            },
            {% endfor -%}
            {
                "title": "gg_encoder_channels",
                "id": "gg_encoder_channels",
                "group": "g_encoders",
                "ui_options": {
                    "wb": {
                        "disable_title": true
                    }
                }
            },
            {% for ls_number in range(1, LIGHT_SCENES_NUMBER + 1) -%}
            {
                "title": "g_light_scene_{{ ls_number }}",
                "id": "g_light_scene_{{ ls_number }}",
                "description": "light_scenes_description"
            },
            {
                "title": "gg_ls_actions_turn_on",
                "id": "gg_ls_{{ ls_number }}_actions_turn_on",
                "group": "g_light_scene_{{ ls_number }}"
            },
            {
                "title": "gg_ls_actions_turn_off",
                "id": "gg_ls_{{ ls_number }}_actions_turn_off",
                "group": "g_light_scene_{{ ls_number }}"
            },
            {
                "title": "gg_ls_channels",
                "id": "gg_ls_{{ ls_number }}_channels",
                "group": "g_light_scene_{{ ls_number }}",
                "ui_options": {
                    "wb": {
                        "disable_title": true
                    }
                }
            },
            {% for ch_number in range(1, OUTPUTS_NUMBER + 1) -%}
            {
                "title": "g_out{{ ch_number }}",
                "id": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_on",
                "group": "gg_ls_{{ ls_number }}_actions_turn_on"
            },
            {
                "title": "g_out{{ ch_number }}",
                "id": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_off",
                "group": "gg_ls_{{ ls_number }}_actions_turn_off"
            },
            {% endfor -%}
            {% endfor -%}
            {
                "title": "g_safety",
                "id": "g_safety",
                "description": "g_safety_description"
            },
            {
                "title": "g_power_up_behaviour",
                "id": "g_power_up_behaviour",
                "description": "g_power_up_behaviour_description"
            },
            {
                "title": "gg_safety_behaviour",
                "id": "gg_safety_behaviour",
                "group": "g_safety"
            },
            {% for ch_number in range(1, OUTPUTS_NUMBER + 1) -%}
            {
                "title": "g_out{{ ch_number }}",
                "id": "gg_safety_mode_ch_{{ ch_number }}",
                "group": "gg_safety_behaviour"
            },
            {
                "title": "g_out{{ ch_number }}",
                "id": "gg_power_up_behaviour_ch_{{ ch_number }}",
                "group": "g_power_up_behaviour"
            },
            {% endfor -%}
            {
                "title": "gg_safety_input_control",
                "id": "gg_safety_input_control",
                "description": "inputs_control_in_safety_mode_description",
                "group": "g_safety"
            },
            {
                "title": "g_general",
                "id": "g_general"
            },
            {
                "title": "g_hw_info",
                "id": "g_hw_info"
            },
            {
                "title": "g_debug",
                "id": "g_debug"
            }
        ],
        "parameters": [
            {
                "id": "outputs_mode",
                "title": "p_outputs_mode",
                "address": 10,
                "reg_type": "holding",
                "enum": [0, 1],
                "enum_titles": [
                    "e_pwm_10v",
                    "e_analog_0_10v"
                ],
                "default": 1,
                "group": "gg_outputs_common",
                "order": 1
            },
            {
                "id": "pwm_frequency_factor",
                "title": "pwm_frequency_factor_title",
                "description": "pwm_frequency_factor_description",
                "address": 9,
                "reg_type": "holding",
                "default": 24,
                "min": 1,
                "max": 240,
                "group": "gg_outputs_common",
                "order": 2
            },
            {% for ch_number in range(1, OUTPUTS_NUMBER + 1) -%}
            {
                "id": "output{{ ch_number }}_min",
                "title": "p_level_1_voltage",
                "description": "level_1_voltage_description",
                "group": "g_out{{ ch_number }}",
                "address": {{ 912 + ch_number - 1 }},
                "reg_type": "holding",
                "default": 100,
                "min": 0,
                "max": 10000,
                "order": 1
            },
            {
                "id": "output{{ ch_number }}_max",
                "title": "p_level_100_voltage",
                "description": "level_100_voltage_description",
                "group": "g_out{{ch_number}}",
                "address": {{928 + ch_number - 1}},
                "reg_type": "holding",
                "default": 10000,
                "min": 0,
                "max": 10000,
                "order": 2
            },
            {
                "id": "output{{ ch_number }}_decrement_rate",
                "title": "p_decrement_rate",
                "description": "decrease_rate_description",
                "group": "g_out{{ch_number}}",
                "address": {{944 + ch_number - 1}},
                "reg_type": "holding",
                "default": 20,
                "min": 0,
                "max": 500,
                "order": 3
            },
            {
                "id": "output{{ ch_number }}_increment_rate",
                "title": "p_increment_rate",
                "description": "increase_rate_description",
                "group": "g_out{{ch_number}}",
                "address": {{960 + ch_number - 1}},
                "reg_type": "holding",
                "default": 20,
                "min": 0,
                "max": 500,
                "order": 4
            },
            {
                "id": "action{{ch_number}}_repeat_time",
                "title": "p_action_repeat_time",
                "description": "action_repeat_time_description",
                "group": "g_out{{ch_number}}",
                "address": {{896 + ch_number - 1}},
                "reg_type": "holding",
                "default": 20,
                "min": 5,
                "max": 500,
                "order": 5
            },
            {% endfor -%}
            {% for ch_number in range(0, INPUTS_NUMBER) -%}
            {% set cond_enc_num = (ch_number // 2) + 1 -%}
            {% set encoder_disabled_condition = "(encoder_" ~ cond_enc_num ~ "_mode==0)" if cond_enc_num <= ENCODERS_NUMBER else "(1==1)" -%}
            {
                "id": "input_{{ch_number + 1}}_mode",
                "title": "p_input_mode",
                "address": {{416 + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1],
                "enum_titles": [
                    "e_button",
                    "e_switch"
                ],
                "default": 0,
                "group": "g_in{{ch_number + 1}}",
                "condition": "{{encoder_disabled_condition}}"
            },
            {
                "id": "input_{{ch_number + 1}}_hold_time",
                "title": "p_hold_time",
                "description": "input_hold_time_description",
                "address": {{1100 + ch_number}},
                "reg_type": "holding",
                "default": 1000,
                "min": 500,
                "max": 5000,
                "group": "gg_in{{ch_number + 1}}_press_params",
                "condition": "input_{{ch_number + 1}}_mode!=1&&{{encoder_disabled_condition}}",
                "order": 1
            },
            {
                "id": "input_{{ch_number + 1}}_double_time",
                "title": "p_double_time",
                "description": "input_double_time_description",
                "address": {{1140 + ch_number}},
                "reg_type": "holding",
                "default": 300,
                "min": 0,
                "max": 2000,
                "group": "gg_in{{ch_number + 1}}_press_params",
                "condition": "input_{{ch_number + 1}}_mode!=1&&{{encoder_disabled_condition}}",
                "order": 2
            },
            {
                "id": "input_{{ch_number + 1}}_debounce_time",
                "title": "p_debounce_time",
                "description": "input_debounce_time_description",
                "address": {{1160 + ch_number}},
                "reg_type": "holding",
                "default": 50,
                "min": 2,
                "max": 200,
                "group": "gg_in{{ch_number + 1}}_press_params",
                "order": 3
            },
            {% for press_type in PRESS_TYPES -%}
            {% set action_bind = ("input {} {} press output".format(ch_number + 1, press_type))|replace(' ', '_') -%}
            {
                "id": "{{action_bind}}_number",
                "title": "p_output_number",
                "address": {{768 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1, 2, 3, 4, 100, {%for ls in range(LIGHT_SCENES_NUMBER) %}{{32 + ls}}{% if not loop.last %}, {% endif %}{% endfor %}],
                "enum_titles": [
                    "e_no_action",
                    "e_output1",
                    "e_output2",
                    "e_output3",
                    "e_output4",
                    "e_all_outputs",
                    {% for ls_number in range(1, LIGHT_SCENES_NUMBER + 1) -%}
                    "e_light_scene{{ls_number}}"{% if not loop.last %},{% endif %}
                    {% endfor -%}
                ],
                "default": 0,
                "group": "gg_in{{ch_number + 1}}_{{press_type | replace(' ', '_')}}_press_action",
                "condition": "input_{{ch_number + 1}}_mode!=1&&{{encoder_disabled_condition}}",
                "order": 1
            },
            {
                "id": "{{action_bind}}_action_single",
                "title": "p_action",
                "address": {{832 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                {% if press_type in ["long", "short long"] %}"enum": [0, 1, 2, 3, 4, 5],{% else %}"enum": [0, 1, 2, 3, 4],{% endif %}
                "enum_titles": [
                    "e_turn_off",
                    "e_turn_on",
                    "e_toggle",
                    "e_decrease_level",
                    "e_increase_level"{% if press_type in ["long", "short long"] %},
                    "e_increase_decrease_level"{% endif %}
                ],
                "default": 0,
                "group": "gg_in{{ch_number + 1}}_{{press_type | replace(' ', '_')}}_press_action",
                "order": 2,
                "condition": "({{action_bind}}_number>=1)&&({{action_bind}}_number<=4)&&{{encoder_disabled_condition}}"
            },
            {
                "id": "{{action_bind}}_action_all",
                "title": "p_action",
                "address": {{832 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1, 3, 4],
                "enum_titles": [
                    "e_turn_off",
                    "e_turn_on",
                    "e_decrease_level",
                    "e_increase_level"
                ],
                "default": 0,
                "group": "gg_in{{ch_number + 1}}_{{press_type | replace(' ', '_')}}_press_action",
                "order": 2,
                "condition": "{{ action_bind }}_number==100&&{{encoder_disabled_condition}}"
            },
            {
                "id": "{{action_bind}}_action_scene",
                "title": "p_action",
                "address": {{832 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1, 2],
                "enum_titles": [
                    "e_scene_light_off",
                    "e_scene_light_on",
                    "e_scene_light_toggle"
                ],
                "group": "gg_in{{ch_number + 1}}_{{press_type | replace(' ', '_')}}_press_action",
                "order": 2,
                "condition": "{{ action_bind }}_number>=32&&{{ action_bind }}_number<=39&&{{encoder_disabled_condition}}"
            },
            {% endfor -%}
            {# Dimming step for short presses -#}
            {% for press_type in SHORT_PRESS_TYPES -%}
            {% set action_bind = ("input {} {} press output".format(ch_number + 1, press_type))|replace(' ', '_')  -%}
            {
                "id": "input_{{ch_number+1}}_{{press_type}}_press_changing_step",
                "group": "gg_in{{ch_number + 1}}_{{press_type | replace(' ', '_')}}_press_action",
                "title": "p_change_step",
                "order": 3,
                "address": {{1200 + ch_number + loop.index0 * 20}},
                "reg_type": "holding",
                "default": {{SHORT_PRESS_CHANGE_STEP_DEFAULT}},
                "min": 1,
                "max": {{SHORT_PRESS_CHANGE_STEP_MAX}},
                "condition": "(input_{{ch_number+1}}_mode!=1)&&((({{action_bind}}_number>=1)&&({{action_bind}}_number<=4))||({{action_bind}}_number==100))&&((({{action_bind}}_action_single>=3)&&({{action_bind}}_action_single<=4))||(({{action_bind}}_action_all>=3)&&({{action_bind}}_action_all<=4)))&&{{encoder_disabled_condition}}"
            },
            {% endfor -%}
            {% for sw_act in ["off", "on"] -%}
            {
                "id": "input_{{ch_number + 1}}_switch_{{sw_act}}_channel",
                "title": "p_output_number",
                "address": {{704 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1, 2, 3, 4, 100, {%for ls in range(LIGHT_SCENES_NUMBER) %}{{32 + ls}}{% if not loop.last %}, {% endif %}{% endfor %}],
                "enum_titles": [
                    "e_no_action",
                    "e_output1",
                    "e_output2",
                    "e_output3",
                    "e_output4",
                    "e_all_outputs",
                    {% for ls_number in range(1, LIGHT_SCENES_NUMBER + 1) -%}
                    "e_light_scene{{ls_number}}"{% if not loop.last %},{% endif %}
                    {% endfor -%}
                ],
                "default": 0,
                "group": "gg_in{{ch_number + 1}}_switch_{{sw_act}}_action",
                "condition": "input_{{ch_number + 1}}_mode==1&&{{encoder_disabled_condition}}",
                "order": 1
            },
            {
                "id": "input_{{ch_number + 1}}_switch_{{sw_act}}_action_single",
                "title": "p_action",
                "address": {{736 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1, 2],
                "enum_titles": [
                    "e_turn_off",
                    "e_turn_on",
                    "e_toggle"
                ],
                "default": {{ 0 if sw_act == "off" else 1}},
                "group": "gg_in{{ch_number + 1}}_switch_{{sw_act}}_action",
                "condition": "input_{{ch_number + 1}}_switch_{{sw_act}}_channel>=1&&input_{{ch_number + 1}}_switch_{{sw_act}}_channel<=4&&{{encoder_disabled_condition}}",
                "order": 2
            },
            {
                "id": "input_{{ch_number + 1}}_switch_{{sw_act}}_action_all",
                "title": "p_action",
                "address": {{736 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1],
                "enum_titles": [
                    "e_turn_off",
                    "e_turn_on"
                ],
                "default": {{ 0 if sw_act == "off" else 1}},
                "group": "gg_in{{ch_number + 1}}_switch_{{sw_act}}_action",
                "condition": "input_{{ch_number + 1}}_switch_{{sw_act}}_channel==100&&{{encoder_disabled_condition}}",
                "order": 2
            },
            {
                "id": "input_{{ch_number + 1}}_switch_{{sw_act}}_action_scene",
                "title": "p_action",
                "address": {{736 + (loop.index0 * 16) + ch_number}},
                "reg_type": "holding",
                "enum": [0, 1, 2],
                "enum_titles": [
                    "e_scene_light_off",
                    "e_scene_light_on",
                    "e_scene_light_toggle"
                ],
                "default": {{ 0 if sw_act == "off" else 1 }},
                "group": "gg_in{{ch_number + 1}}_switch_{{sw_act}}_action",
                "condition": "input_{{ch_number + 1}}_switch_{{sw_act}}_channel>=32&&input_{{ch_number + 1}}_switch_{{sw_act}}_channel<=39&&{{encoder_disabled_condition}}",
                "order": 2
            },
            {% endfor -%}
            {% endfor -%}
            {% for ls_number in range(1, LIGHT_SCENES_NUMBER + 1) -%}
            {
                "id": "ls_{{ls_number}}_light_on_off_condition",
                "title": "p_scene_light_condition",
                "reg_type": "holding",
                "address": {{1264 + (ls_number - 1)}},
                "type": "enum",
                "enum": [0, 1],
                "enum_titles": [
                    "e_scene_cond_any",
                    "e_scene_cond_all"
                ],
                "group": "g_light_scene_{{ ls_number }}"
            },
            {% for ch_number in range(1, OUTPUTS_NUMBER + 1) -%}
            {
                "id": "ls_{{ls_number}}_ch_{{ch_number}}_action_off",
                "title": "p_action",
                "reg_type": "holding",
                "address": {{1280 + 0 + 64 * (ls_number - 1) + (ch_number - 1)}},
                "type": "enum",
                "enum": [0, 2, 3],
                "enum_titles": [
                    "e_ch_not_used",
                    "e_turn_on",
                    "e_turn_on_set_brightness"
                ],
                "group": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_on"
            },
            {
                "id": "ls_{{ls_number}}_ch_{{ch_number}}_fading_off",
                "title": "p_fading_rate",
                "reg_type": "holding",
                "address": {{1280 + 8 + 64 * (ls_number - 1) + (ch_number - 1)}},
                "min": 0,
                "max": 500,
                "default": 20,
                "required": true,
                "group": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_on",
                "condition": "ls_{{ls_number}}_ch_{{ch_number}}_action_off>=1"
            },
            {
                "id": "ls_{{ls_number}}_ch_{{ch_number}}_level_off",
                "title": "p_level",
                "reg_type": "holding",
                "address": {{1280 + 16 + 64 * (ls_number - 1) + (ch_number - 1)}},
                "min": 1,
                "max": 100,
                "default": 50,
                "required": true,
                "group": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_on",
                "condition": "ls_{{ls_number}}_ch_{{ch_number}}_action_off==3"
            },
            {
                "id": "ls_{{ls_number}}_ch_{{ch_number}}_action_on",
                "title": "p_action",
                "reg_type": "holding",
                "address": {{1280 + 32 + 64 * (ls_number - 1) + (ch_number - 1)}},
                "type": "enum",
                "enum": [0, 1, 3],
                "enum_titles": [
                    "e_ch_not_used",
                    "e_turn_off",
                    "e_set_level"
                ],
                "group": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_off"
            },
            {
                "id": "ls_{{ls_number}}_ch_{{ch_number}}_fading_on",
                "title": "p_fading_rate",
                "reg_type": "holding",
                "address": {{1280 + 40 + 64 * (ls_number - 1) + (ch_number - 1)}},
                "min": 0,
                "max": 500,
                "default": 20,
                "required": true,
                "group": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_off",
                "condition": "ls_{{ls_number}}_ch_{{ch_number}}_action_on>=1"
            },
            {
                "id": "ls_{{ls_number}}_ch_{{ch_number}}_level_on",
                "title": "p_level",
                "reg_type": "holding",
                "address": {{1280 + 48 + 64 * (ls_number - 1) + (ch_number - 1)}},
                "min": 1,
                "max": 100,
                "default": 50,
                "required": true,
                "group": "gg_ls_{{ls_number}}_ch_{{ch_number}}_action_turn_off",
                "condition": "ls_{{ls_number}}_ch_{{ch_number}}_action_on==3"
            },
            {% endfor -%}
            {% endfor -%}
            {
                "id": "safety_timer_s",
                "title": "safety_timer_s",
                "group": "g_safety",
                "description": "poll_timeout_description",
                "address": 8,
                "order": 2,
                "reg_type": "holding",
                "min": 1,
                "max": 65534,
                "default": 10
            },
            {% for ch_number in range(1, OUTPUTS_NUMBER + 1) -%}
            {
                "id": "safety_mode_ch_{{ch_number}}_action",
                "title": "p_action",
                "reg_type": "holding",
                "address": {{648 + ch_number - 1}},
                "type": "enum",
                "enum": [0, 1, 2, 3],
                "enum_titles": [
                    "e_no_action",
                    "e_turn_off",
                    "e_turn_on",
                    "e_set_level"
                ],
                "group": "gg_safety_mode_ch_{{ ch_number }}"
            },
            {
