                "enum_titles": [
                    "ch_heating_mode_enum_0",
                    "ch_heating_mode_enum_1"
                ],
                "default": 0,
                "group": "g_heating",
                "condition": "heating_options==1"
            },
            {
                "id": "climate_curve_number",
                "description": "climate_curve_number_description",
                "reg_type": "holding",
                "address": 206,
                "format": "u16",
                "min": 1,
                "max": 17,
                "default": 1,
                "group": "g_heating",
                "condition": "heating_options==2"
            },
            {
                "id": "boiler_manufacturer",
                "reg_type": "holding",
                "address": 223,
                "format": "u16",
                "enum": [0, 1, 2, 3],
                "enum_titles": [
                    "boiler_manufacturer_enum_0",
                    "boiler_manufacturer_enum_1",
                    "boiler_manufacturer_enum_2",
                    "boiler_manufacturer_enum_3"
                ],
                "default": 0,
                "group": "g_heating"
            },
            {
                "id": "ot_algorithm",
                "reg_type": "holding",
                "address": 219,
                "format": "u16",
                "enum": [0, 1, 2],
                "enum_titles": [
                    "ot_algorithm_enum_0",
                    "ot_algorithm_enum_1",
                    "ot_algorithm_enum_2"
                ],
                "default": 1,
                "group": "g_opentherm"
            }
        ],
        "setup": [
            {
                "title": "disable direct heating setpoint control",
                "reg_type": "holding",
                "address": 203,
                "value": 0,
                "condition": "(heating_options==1)||(heating_options==2)"
            },
            {
                "title": "reset room temperature setpoint",
                "reg_type": "holding",
                "address": 205,
                "value": 0,
                "condition": "heating_options==0"
            },
            {
                "title": "set direct heating setpoint control",
                "reg_type": "holding",
                "address": 207,
                "value": 0,
                "condition": "heating_options==0"
            },
            {
                "title": "set room temperature sensor",
                "reg_type": "holding",
                "address": 207,
                "value": 1,
                "condition": "heating_options==1"
            },
            {
                "title": "set outdoor temperature sensor",
                "reg_type": "holding",
                "address": 207,
                "value": 2,
                "condition": "heating_options==2"
            }
        ],
