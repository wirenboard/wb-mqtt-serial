// testing template for GetConditionParametersRegisterList and GetChannelsRegisterList with condition filtering.
// "Disabled Channel" is disabled by default in config, it must still be read by device/Load.
// The "mode!=1" condition of "Mode Not One" is true when "mode" got no value
{
    "device_type": "device_load_conditions",
    "device": {
        "name": "device load conditions",
        "id": "device_load_conditions",
        "enable_wb_continuous_read": true,
        "parameters": [
            {
                "id": "mode",
                "title": "Mode",
                "address": 100,
                "enum": [0, 1, 2]
            },
            {
                "id": "variant",
                "title": "Variant",
                "address": 101
            },
            {
                "id": "unrelated",
                "title": "Unrelated",
                "address": 102
            }
        ],
        "channels": [
            {
                "name": "Always Visible",
                "reg_type": "input",
                "address": 200
            },
            {
                "name": "Mode Dependent",
                "reg_type": "input",
                "address": 201,
                "condition": "mode==1"
            },
            {
                "name": "Variant Dependent",
                "reg_type": "input",
                "address": 202,
                "condition": "variant==2"
            },
            {
                "name": "Write Only",
                "reg_type": "holding",
                "write_address": 203
            },
            {
                "name": "Disabled Channel",
                "reg_type": "input",
                "address": 204,
                "enabled": false
            },
            {
                "name": "Mode Not One",
                "reg_type": "input",
                "address": 205,
                "condition": "mode!=1"
            }
        ]
    }
}