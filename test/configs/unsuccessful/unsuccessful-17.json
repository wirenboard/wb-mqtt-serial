// simultaneously active declarations of a parameter with different conditions do not form
// a single chain of fw variants and are treated as a duplicate definition
{
    "ports": [
        {
            "path" : "/dev/ttyNSC0",
            "baud_rate": 9600,
            "parity": "N",
            "data_bits": 8,
            "stop_bits": 2,
            "devices" : [
                {
                    "slave_id": 22,
                    "device_type": "fw variants condition overlap",
                    "p1": 1
                }
            ]
        }
    ]
}
