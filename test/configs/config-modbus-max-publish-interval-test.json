{
    "debug": true,
    "ports": [
        {
            "path": "/dev/ttyNSC0",
            "baud_rate": 9600,
            "parity": "N",
            "data_bits": 8,
            "stop_bits": 1,
            "enabled": true,
            "devices": [
                {
                    "slave_id": 1,
                    "enabled": true,
                    "name": "Modbus-sample",
                    "id": "modbus-sample",
                    "max_publish_interval": 10,
                    "channels": [
                        {
                            "name": "Channel With Interval",
                            "reg_type": "input",
                            "address": 23,
                            "type": "value",
                            "format": "u16"
                        },
                        {
                            "name": "Channel Without Interval",
                            "reg_type": "input",
                            "address": 42,
                            "type": "value",
                            "format": "u16",
                            "max_publish_interval": 0
                        }
                    ]
                }
            ]
        }
    ]
}
